@model ST10398576_EventEase.Models.Event
@{
    ViewData["Title"] = "Event Details";
}

<div class="card mb-3">
    <div class="card-body">
        <h2 class="card-title">@Model.EventName</h2>

        <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMM yyyy")</p>
        <p><strong>Venue:</strong> @Model.Venue?.VenueName</p>
        <p><strong>Description:</strong> @Model.Description</p>


        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </div>
    </div>
</div>
