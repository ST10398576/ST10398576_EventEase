@model ST10398576_EventEase.Models.Venue
@{
    ViewData["Title"] = "Edit Venue";
}

<h2>Edit Venue</h2>

<form asp-action="Edit" asp-route-id="@Model.VenueId" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="VenueId" />

    <div>
        <label asp-for="VenueName"></label>
        <input asp-for="VenueName" class="form-control" />
        <span asp-validation-for="VenueName" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Location"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Capacity"></label>
        <input asp-for="Capacity" class="form-control" type="number" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IsAvailable" class="control-label"></label>
        <input asp-for="IsAvailable" class="form-check-input" />
        <span asp-validation-for="IsAvailable" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Current Image</label><br />
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.VenueName" style="max-width:200px; height:auto;" />
        }
        else
        {
            <span class="text-muted">No image uploaded yet</span>
        }
    </div>

    <div class="form-group">
        <label>Upload New Image (optional)</label>
        <input type="file" name="imageFile" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>


    <div>
        <button type="submit" class="btn btn-primary">Edit</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>