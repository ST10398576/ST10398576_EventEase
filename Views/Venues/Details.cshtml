@model ST10398576_EventEase.Models.Venue
@{
    ViewData["Title"] = "Venue Details";
}

<h2>@Model.VenueName</h2>

<div>
    <p><strong>Location:</strong> @Model.Location</p>
    <p><strong>Capacity:</strong> @Model.Capacity</p>
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="@Model.VenueName" style="max-width:400px; height:auto;" />
    }
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
</p>
