@model IEnumerable<ST10398576_EventEase.Models.Booking>
@{
    ViewData["Title"] = "Bookings";
}

<div class="container">
    <header class="d-flex align-items-center justify-content-between py-4">
        <div>
            <h1 class="h3 mb-0">Bookings</h1>
            <p class="text-muted small mb-0">View and manage bookings.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">Create New Booking</a>
        </div>
    </header>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Venue</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td>@b.Event?.EventName</td>
                                <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                                <td>@b.Venue?.VenueName</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group" aria-label="Actions">
                                        <a asp-action="Details" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-primary">Details</a>
                                        <a asp-action="Edit" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
