@{
    ViewData["Title"] = "Home";
}

<div class="container">
    <header class="text-center py-5">
        <h1 class="display-5 fw-bold">Welcome to EventEase</h1>
        <p class="lead text-muted">Manage your venues, events, and bookings with ease.</p>
    </header>

    <section class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Venues</h5>
                    <p class="card-text text-muted">Manage venue details and images.</p>
                    <a asp-controller="Venues" asp-action="Index" class="btn btn-primary w-100">View Venues</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Events</h5>
                    <p class="card-text text-muted">Create and manage events.</p>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-success w-100">View Events</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Bookings</h5>
                    <p class="card-text text-muted">View and manage bookings.</p>
                    <a asp-controller="Bookings" asp-action="Index" class="btn btn-warning w-100">View Bookings</a>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-4">
        <h3 class="mb-3">Bookings Overview</h3>

        <div class="card mb-3">
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Search</label>
                        <input type="text" name="searchString" placeholder="Event or Venue" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Event Type</label>
                        <select name="eventTypeId" class="form-select">
                            <option value="">All types</option>
                            @foreach (var type in ViewBag.EventTypes as List<EventType>)
                            {
                                <option value="@type.EventTypeId">@type.EventTypeName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Start</label>
                        <input type="date" name="startDate" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">End</label>
                        <input type="date" name="endDate" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Availability</label>
                        <select name="isAvailable" class="form-select">
                            <option value="">Any</option>
                            <option value="true">Available</option>
                            <option value="false">Unavailable</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary w-100">Filter</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Booking ID</th>
                        <th>Venue</th>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Capacity</th>
                        <th>Event Type</th>
                        <th>Availability</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@item.BookingId</td>
                            <td>@item.VenueName</td>
                            <td>@item.EventName</td>
                            <td>@item.BookingDate.ToShortDateString()</td>
                            <td>@item.Capacity</td>
                            <td>@item.EventType</td>
                            <td>
                                @(item.IsAvailable ? "Available" : "Unavailable")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
